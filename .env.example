# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# 선택: 기본 모델 변경
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_FAST_MODEL=claude-haiku-4-5
# 선택: #06 GitHub PR 리뷰 봇
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# 선택: #13 로컬 LLM 서빙 벤치마크
# OLLAMA_URL=http://localhost:11434
# 선택: 공개 배포용 비용·남용 방지 (0 또는 미설정 = 무제한, 프로세스 메모리 기준이라 재시작 시 초기화)
# DAILY_BUDGET_USD=1
# LLM_REQUESTS_PER_HOUR=30
# POST 본문 상한 MB (미설정 시 12, 0이면 무제한). 이 .env 로더는 줄 끝 주석을 지원하지 않으니 값 뒤에 주석을 붙이지 마세요
# MAX_BODY_MB=12
# 선택: 레이트 리밋용 클라이언트 IP 판별 (기본: Cloudflare가 넣는 cf-connecting-ip → 없으면 X-Forwarded-For)
# Cloudflare 뒤가 아닌 곳에 배포하면 CLIENT_IP_HEADER= 로 비우고, 프록시 홉 수를 지정하세요
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXY_HOPS=0
